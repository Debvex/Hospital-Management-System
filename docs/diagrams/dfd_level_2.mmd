flowchart TB
    Patient[Patient]
    Doctor[Doctor]
    Receptionist[Receptionist]
    Administrator[Administrator]

    subgraph HMS[Hospital Management System — Level 2 Decomposition]
        subgraph AUTH[1.0 Authentication and User Management]
            A11((1.1 Validate Registration))
            A12((1.2 Hash Password))
            A13((1.3 Verify Credentials))
            A14((1.4 Generate JWT))
            A15((1.5 Check Role Permissions))
            A16((1.6 Manage Role Profile))
        end

        subgraph AVAIL[2.0 Doctor and Availability Management]
            B11((2.1 Maintain Department))
            B12((2.2 Maintain Doctor Profile))
            B13((2.3 Define Availability))
            B14((2.4 Validate Time Range))
            B15((2.5 Publish Open Slots))
        end

        subgraph APPT[3.0 Appointment Management]
            C11((3.1 Receive Booking Request))
            C12((3.2 Validate Patient and Doctor))
            C13((3.3 Check Slot Availability))
            C14((3.4 Create Appointment))
            C15((3.5 Prevent Duplicate Booking))
            C16((3.6 Update Status))
            C17((3.7 Cancel or Reschedule))
        end

        subgraph MED[4.0 Medical Records and Prescriptions]
            D11((4.1 Verify Doctor Assignment))
            D12((4.2 Open Patient Context))
            D13((4.3 Save Diagnosis and Notes))
            D14((4.4 Create Prescription))
            D15((4.5 Add Prescription Items))
            D16((4.6 Publish Permitted History))
        end

        subgraph BILL[5.0 Billing and Reporting]
            E11((5.1 Read Consultation Fee))
            E12((5.2 Add Approved Charges))
            E13((5.3 Calculate Invoice Total))
            E14((5.4 Record Payment Status))
            E15((5.5 Produce Operational Report))
            E16((5.6 Write Audit Event))
        end
    end

    DB[(D1: PostgreSQL Database<br/>Tables: USER_ACCOUNT, role profiles,<br/>DEPARTMENT, DOCTOR_AVAILABILITY,<br/>APPOINTMENT, MEDICAL_RECORD,<br/>PRESCRIPTION, PRESCRIPTION_ITEM,<br/>INVOICE, INVOICE_ITEM, AUDIT_LOG)]

