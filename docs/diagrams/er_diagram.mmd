erDiagram
    USER_ACCOUNT {
        bigint user_id PK
        varchar email UK
        varchar password_hash
        varchar role
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }

    PATIENT_PROFILE {
        bigint patient_id PK
        bigint user_id FK
        varchar full_name
        date date_of_birth
        varchar blood_group
        varchar contact_number
        text address
        varchar emergency_contact
        timestamp created_at
        timestamp updated_at
    }

    DOCTOR_PROFILE {
        bigint doctor_id PK
        bigint user_id FK
        bigint department_id FK
        varchar full_name
        varchar specialization
        varchar license_number UK
        decimal consultation_fee
        varchar room_number
        timestamp created_at
        timestamp updated_at
    }

    ADMINISTRATOR_PROFILE {
        bigint administrator_id PK
        bigint user_id FK
        varchar full_name
        varchar employee_number UK
        varchar contact_number
        timestamp created_at
        timestamp updated_at
    }

    RECEPTIONIST_PROFILE {
        bigint receptionist_id PK
        bigint user_id FK
        varchar full_name
        varchar employee_number UK
        varchar contact_number
        timestamp created_at
        timestamp updated_at
    }

    DEPARTMENT {
        bigint department_id PK
        varchar department_name UK
        text description
        boolean is_active
        timestamp created_at
    }

    DOCTOR_AVAILABILITY {
        bigint availability_id PK
        bigint doctor_id FK
        date available_date
        time start_time
        time end_time
        boolean is_active
        timestamp created_at
    }

    APPOINTMENT {
        bigint appointment_id PK
        bigint patient_id FK
        bigint doctor_id FK
        bigint availability_id FK
        bigint created_by_user_id FK
        date appointment_date
        time start_time
        time end_time
        varchar status
        text reason
        timestamp created_at
        timestamp updated_at
    }

    MEDICAL_RECORD {
        bigint medical_record_id PK
        bigint appointment_id FK
        text diagnosis
        text consultation_notes
        timestamp created_at
        timestamp updated_at
    }

    PRESCRIPTION {
        bigint prescription_id PK
        bigint medical_record_id FK
        text notes
        timestamp issued_at
    }

    PRESCRIPTION_ITEM {
        bigint prescription_item_id PK
        bigint prescription_id FK
        varchar medicine_name
        varchar dosage
        varchar frequency
        varchar duration
        text instructions
    }

    INVOICE {
        bigint invoice_id PK
        bigint appointment_id FK
        decimal subtotal
        decimal additional_charges
        decimal total_amount
        varchar payment_status
        timestamp paid_at
        timestamp issued_at
        timestamp updated_at
    }

    INVOICE_ITEM {
        bigint invoice_item_id PK
        bigint invoice_id FK
        varchar description
        integer quantity
        decimal unit_price
        decimal line_total
    }

    AUDIT_LOG {
        bigint audit_log_id PK
        bigint actor_user_id FK
        varchar action
        varchar resource_type
        bigint resource_id
        json metadata
        varchar ip_address
        timestamp created_at
    }

    USER_ACCOUNT ||--o| PATIENT_PROFILE : "has profile"
    USER_ACCOUNT ||--o| DOCTOR_PROFILE : "has profile"
    USER_ACCOUNT ||--o| ADMINISTRATOR_PROFILE : "has profile"
    USER_ACCOUNT ||--o| RECEPTIONIST_PROFILE : "has profile"

    DEPARTMENT ||--o{ DOCTOR_PROFILE : "contains"
    DOCTOR_PROFILE ||--o{ DOCTOR_AVAILABILITY : "defines"

    PATIENT_PROFILE ||--o{ APPOINTMENT : "books"
    DOCTOR_PROFILE ||--o{ APPOINTMENT : "conducts"
    DOCTOR_AVAILABILITY ||--o{ APPOINTMENT : "provides slot"
    USER_ACCOUNT ||--o{ APPOINTMENT : "creates"

    APPOINTMENT ||--o| MEDICAL_RECORD : "produces"
    MEDICAL_RECORD ||--o| PRESCRIPTION : "may have"
    PRESCRIPTION ||--|{ PRESCRIPTION_ITEM : "contains"

    APPOINTMENT ||--o| INVOICE : "generates"
    INVOICE ||--|{ INVOICE_ITEM : "contains"

    USER_ACCOUNT ||--o{ AUDIT_LOG : "creates"
